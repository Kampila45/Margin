# =============================================================================
# Margin — Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit real API keys or secrets to version control.
# =============================================================================

# Application Environment ("Development", "Staging", "Production")
APP_NAME=Margin
APP_ENV=Development
APP_DEBUG=false
LOG_LEVEL=INFO

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://margin:margin_dev_password@localhost:5432/margin

# File Storage & Upload Limits
STORAGE_PROVIDER=local
STORAGE_DIR=./storage/uploads
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO). Set STORAGE_PROVIDER=s3 to enable.
S3_BUCKET=your-bucket
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=documents
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_PAGES_PER_DOCUMENT=150
MAX_DOCUMENTS_PER_SESSION=25

# Document RAG & Chunking Configuration
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=6
SELECTION_SURROUNDING_WINDOW=1

# AI Providers Configuration
# LLM Provider for reasoning, citations, and SQL: "grok" (default) or "gemini"
LLM_PROVIDER=grok

# xAI Grok Configuration (Generation, SQL Assistant, and Q&A)
XAI_API_KEY=your-xai-api-key-here
GROK_MODEL=grok-2-latest
GROK_API_BASE=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=30.0

# Google Gemini Configuration (Embeddings & Semantic Search)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_GENERATION_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_TIMEOUT_SECONDS=30.0

# SQL Assistant & Security Configuration
# 32+ character secret key used to encrypt external database credentials at rest
CREDENTIAL_ENCRYPTION_SECRET=margin-default-credential-encryption-secret-change-in-prod
SQL_ALLOW_PRIVATE_HOSTS=false
SQL_QUERY_TIMEOUT_SECONDS=5.0
SQL_MAX_ROWS=100

# Frontend Public Variables (only browser-safe variables may use VITE_)
VITE_API_BASE_URL=http://localhost:8000/api/v1
